{
  "name": "sap-developer-booking",
  "version": "2.0.0",
  "description": "Professional SAP Developer Booking Website with full automation",
  "main": "index.html",
  "scripts": {
    "start": "npx serve . -l 3000",
    "dev": "npx serve . -l 3000 --cors",
    "lint": "npx eslint src/**/*.js *.js --fix",
    "lint:css": "npx stylelint '**/*.css' --fix",
    "format": "npx prettier --write '**/*.{js,css,html,json,md}'",
    "format:check": "npx prettier --check '**/*.{js,css,html,json,md}'",
    "validate": "npx html-validate index.html",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --coverage",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "build": "npm run lint && npm run format && npm run test:unit",
    "prepare": "echo 'Project ready for deployment'",
    "docker:build": "docker build -t sap-developer-website .",
    "docker:run": "docker run -p 80:80 sap-developer-website",
    "docker:compose": "docker-compose up -d",
    "lighthouse": "npx lighthouse http://localhost:3000 --output=html --output-path=./reports/lighthouse.html",
    "security": "npm audit --audit-level=high",
    "blog:build": "node scripts/build-blog.js",
    "sitemap": "node scripts/generate-sitemap.js"
  },
  "keywords": [
    "sap",
    "developer",
    "booking",
    "freelance",
    "abap",
    "fiori",
    "s4hana",
    "consulting"
  ],
  "author": "SAP Developer",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@sentry/browser": "^7.100.0",
    "chart.js": "^4.4.1",
    "eslint": "^8.57.0",
    "html-validate": "^8.18.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "marked": "^11.2.0",
    "prettier": "^3.2.5",
    "serve": "^14.2.1",
    "stylelint": "^16.2.1",
    "stylelint-config-standard": "^36.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vziegler2/claude_code2.git"
  },
  "homepage": "https://vziegler2.github.io/claude_code2",
  "bugs": {
    "url": "https://github.com/vziegler2/claude_code2/issues"
  }
}
